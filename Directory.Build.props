<Project>
  <!--
    Applies to every C# project in this repository (Core, tests, and the
    WinUI app that Phase 3 adds).

    x64 only: the native DLL is built for x64, and an AnyCPU test host
    could come up as a 32-bit process, which would fail to load it with a
    confusing BadImageFormatException instead of a clear error.
  -->
  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Deterministic, reviewable diffs. -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
