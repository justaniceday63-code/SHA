<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShaGui.App.Pages.VerifyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ShaGui.App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Algorithm chips: a pill restyle of the RadioButtons items. The
             radio dot is dropped — selection reads as an accent fill — while
             the labels stay plain text so UIA can still invoke them by name. -->
        <Style x:Key="AlgoChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid>
                                <!-- Accent fill sits under the label and is
                                     revealed by CheckStates, so the hover
                                     states can keep owning the base fill —
                                     the same property split the default
                                     template uses between its two groups. -->
                                <Border x:Name="AccentLayer"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0" />
                                <ContentPresenter x:Name="ChipContent"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Background"
                                                    Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Background"
                                                    Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="AccentLayer.Opacity" Value="1" />
                                            <Setter Target="Chip.BorderBrush"
                                                    Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="ChipContent.Foreground"
                                                    Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Verify integrity" />
                <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Hash text, files or folders with SHA-1 or SHA-256, then compare the digest against an expected value." />
            </StackPanel>

            <!-- One card holds the whole flow — mode, algorithm, input,
                 action and result — so the page reads as a single form
                 instead of loose controls floating on the background. -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <SelectorBar x:Name="ModeBar" AutomationProperties.AutomationId="ModeBar"
                                 SelectionChanged="OnModeChanged">
                        <SelectorBarItem Text="Text" IsSelected="True" Tag="text" />
                        <SelectorBarItem Text="File" Tag="file" />
                        <SelectorBarItem Text="Folder" Tag="folder" />
                    </SelectorBar>

                    <RadioButtons x:Name="AlgoChoice" AutomationProperties.AutomationId="AlgoChoice"
                                  Header="Hash Algorithm" SelectedIndex="1" MaxColumns="2"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnAlgorithmChanged">
                        <RadioButton Content="SHA-1" Tag="sha1" Style="{StaticResource AlgoChipStyle}" />
                        <RadioButton Content="SHA-256" Tag="sha256" Style="{StaticResource AlgoChipStyle}" />
                    </RadioButtons>

                    <!-- Text mode -->
                    <StackPanel x:Name="TextPanel" Spacing="8">
                        <TextBox x:Name="InputText" AutomationProperties.AutomationId="InputText"
                                 Header="Text (hashed as UTF-8)"
                                 PlaceholderText="Type or paste text to hash"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="96"
                                 TextChanged="OnInputTextChanged" />
                    </StackPanel>

                    <!-- File mode -->
                    <StackPanel x:Name="FilePanel" Spacing="8" Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FilePathBox" AutomationProperties.AutomationId="FilePathBox"
                                     Header="File path" IsReadOnly="True"
                                     PlaceholderText="No file selected" />
                            <Button Grid.Column="1" AutomationProperties.AutomationId="BtnBrowseFile"
                                    VerticalAlignment="Bottom"
                                    Click="OnBrowseFile" ToolTipService.ToolTip="Pick a file">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xED25;" FontSize="14" />
                                    <TextBlock Text="Browse…" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Folder mode -->
                    <StackPanel x:Name="FolderPanel" Spacing="8" Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderPathBox" AutomationProperties.AutomationId="FolderPathBox"
                                     Header="Folder path" IsReadOnly="True"
                                     PlaceholderText="No folder selected" />
                            <Button Grid.Column="1" AutomationProperties.AutomationId="BtnBrowseFolder"
                                    VerticalAlignment="Bottom"
                                    Click="OnBrowseFolder" ToolTipService.ToolTip="Pick a folder">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xED25;" FontSize="14" />
                                    <TextBlock Text="Browse…" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Every file is hashed with its path relative to the root. Symlinks are skipped and reported, never silently followed." />
                    </StackPanel>

                    <TextBox x:Name="ExpectedBox" AutomationProperties.AutomationId="ExpectedBox"
                             Header="Expected digest (optional — paste to compare)"
                             PlaceholderText="e.g. a9993e364706816aba3e25717850c26c9cd0d89d"
                             TextChanged="OnExpectedChanged" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="HashButton" AutomationProperties.AutomationId="HashButton"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnHashClicked" ToolTipService.ToolTip="Compute the digest">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE928;" FontSize="14" />
                                <TextBlock Text="Hash" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton"
                                Click="OnCancelClicked" IsEnabled="False"
                                ToolTipService.ToolTip="Stop the running hash">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
                    </StackPanel>

                    <ProgressBar x:Name="RunProgress" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" />

                    <InfoBar x:Name="ResultBar" AutomationProperties.AutomationId="ResultBar"
                             IsOpen="False" IsClosable="False" />

                    <!-- Result: caption names the algorithm that produced the
                         digest below it; Copy grabs that digest. -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultLabel"
                                   AutomationProperties.AutomationId="ResultLabel"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Text="SHA-256 hash result" />
                        <Button Grid.Column="1" AutomationProperties.AutomationId="BtnCopyDigest"
                                Click="OnCopyDigest"
                                ToolTipService.ToolTip="Copy the digest to the clipboard">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="Copy" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBox x:Name="DigestBox" AutomationProperties.AutomationId="DigestBox"
                             IsReadOnly="True" FontFamily="Consolas"
                             TextWrapping="Wrap" AcceptsReturn="True" />
                    <TextBlock x:Name="ElapsedText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ListView x:Name="ManifestList" AutomationProperties.AutomationId="ManifestList"
                              SelectionMode="None" MaxHeight="320" Visibility="Collapsed">
                        <ListView.Header>
                            <Grid Padding="8,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Size" Width="90" />
                                <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="Hash" FontFamily="Consolas" Width="220" />
                                <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Text="Path" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ManifestRow">
                                <Grid Padding="8,2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind SizeText}" Width="90" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind HashText}" FontFamily="Consolas"
                                               Width="220" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
