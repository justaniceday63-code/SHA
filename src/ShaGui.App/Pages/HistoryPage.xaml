<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShaGui.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ShaGui.App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="History &amp; benchmarks" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Text="Runs are stored locally in a SQLite database. Throughput charts are drawn from the same rows, so history and benchmarks can never disagree." />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button AutomationProperties.AutomationId="BtnRefresh" Click="OnRefresh">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.AutomationId="BtnClear" Click="OnClear">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Clear history" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="CountText" AutomationProperties.AutomationId="CountText"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="HistoryStatus" AutomationProperties.AutomationId="HistoryStatus"
                     IsOpen="False" IsClosable="False" />

            <!-- Benchmarks: throughput per run, newest first. Hand-rolled bars
                 keep the chart honest about the same rows the list shows. -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Throughput" />
                <TextBlock x:Name="BenchmarkSummary" AutomationProperties.AutomationId="BenchmarkSummary"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="ChartList" AutomationProperties.AutomationId="ChartList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ChartRow">
                            <Grid Padding="0,2" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <ProgressBar Grid.Column="1" VerticalAlignment="Center"
                                             Minimum="0" Maximum="1" Value="{x:Bind Fraction}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ValueText}" FontFamily="Consolas"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <ListView x:Name="RunList" AutomationProperties.AutomationId="RunList" SelectionMode="None">
                <ListView.Header>
                    <Grid Padding="8,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="When (UTC)" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="Algorithm" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Text="Subject" />
                        <TextBlock Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" Text="Size" />
                        <TextBlock Grid.Column="4" Style="{StaticResource CaptionTextBlockStyle}" Text="MB/s" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:HistoryRow">
                        <Grid Padding="8,2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind When}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Algorithm}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Subject}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Size}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Throughput}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
