<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShaGui.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ShaGui.App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <InfoBar x:Name="HealthBar" AutomationProperties.AutomationId="HealthBar"
                     IsOpen="True" IsClosable="False" />

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Hashing" />
                <NumberBox x:Name="BufferSizeBox" AutomationProperties.AutomationId="BufferSizeBox"
                           Header="Streaming buffer (bytes)"
                           Value="1048576" Minimum="4096" SmallChange="65536"
                           SpinButtonPlacementMode="Compact"
                           Description="Larger buffers read fewer, bigger chunks. The native default is 1 MiB." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Verification" />
                <ToggleSwitch x:Name="IncludeHiddenSwitch" AutomationProperties.AutomationId="IncludeHiddenSwitch"
                              Header="Include hidden and system files"
                              IsOn="True"
                              OnContent="Included" OffContent="Excluded" />
                <ToggleSwitch x:Name="FollowReparseSwitch" AutomationProperties.AutomationId="FollowReparseSwitch"
                              Header="Follow symbolic links and junctions"
                              IsOn="False"
                              OnContent="Followed" OffContent="Skipped and reported" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Following links can loop or escape the folder; skipped links are always reported so a manifest is never silently incomplete." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="History" />
                <ToggleSwitch x:Name="RecordHistorySwitch" AutomationProperties.AutomationId="RecordHistorySwitch"
                              Header="Record runs to local history"
                              IsOn="True" OnContent="Recording" OffContent="Paused" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Runs are stored in a local SQLite database for the History and benchmark pages." />
            </StackPanel>

            <Button AutomationProperties.AutomationId="BtnSaveSettings"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSave" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    <TextBlock Text="Save settings" />
                </StackPanel>
            </Button>
            <InfoBar x:Name="SaveStatus" AutomationProperties.AutomationId="SaveStatus"
                     IsOpen="False" IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
